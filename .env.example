# Copy of .env — real values live ONLY in .env (gitignored). Never commit keys.

# Anthropic API key (console.anthropic.com) — enrichment/classification pipeline
ANTHROPIC_API_KEY=

# Podcast Index — OPTIONAL (we run Apple APIs + direct RSS; see DECISIONS 2026-07-11)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# LLM spend caps in USD, both PER PROCESS (each CLI run starts at $0; see
# docs/DECISIONS.md 2026-10-07). RUN_BUDGET_USD is everything one run may spend
# (default 25, max 1000); EPISODE_BUDGET_USD is one Foray's ceiling (default 10).
# DAILY_BUDGET_USD is the DEPRECATED name of RUN_BUDGET_USD: still read when
# RUN_BUDGET_USD is unset (with one startup warning); set beside a different
# RUN_BUDGET_USD it fails startup. Rename it to RUN_BUDGET_USD.
RUN_BUDGET_USD=25.00
EPISODE_BUDGET_USD=10.00
