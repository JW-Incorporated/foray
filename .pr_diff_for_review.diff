+  sizeProgressBars($("#view"));
+  if (window.ForayPlayer && typeof window.ForayPlayer.applyStripGrow === "function") {
+    window.ForayPlayer.applyStripGrow($("#view"));
+  }
+
+  bindPickLogging($("#view"));
+  bindStars($("#view"));
+  bindUpNext($("#view"));
+  bindPlay($("#view"));
+}
