<?xml version="1.0" encoding="utf-8"?>
<!--
  The library manifest AGP merges into the generated app's manifest. Everything
  the foreground service needs to exist is declared HERE rather than patched into
  `mobile/android/app/src/main/AndroidManifest.xml` after generation, because that
  file is regenerated by `cap add android` and a patch step would have to be
  re-run. Manifest merging is what makes this survive a platform regeneration.

  FOREGROUND_SERVICE_MEDIA_PLAYBACK is required from Android 14 (API 34):
  "Beginning with Android 14 (API level 34), you must declare an appropriate
  service type for each foreground service" — and `mediaPlayback` is the type
  chosen because, unlike `dataSync` and `mediaProcessing`, it has no runtime
  prerequisites and NO RUNTIME TIMEOUT
  (docs/research/mp1-background-audio.md §5.3). A Foray is 45 to 90 minutes; a
  service type with a timeout would not survive one.

  POST_NOTIFICATIONS IS DELIBERATELY NOT DECLARED. A foreground service still runs
  when the notification permission is denied — the notification is simply not
  shown — so the process-importance and audio-focus properties this service exists
  for do not depend on it. Asking for the permission means a runtime prompt and UI
  to explain it, and the notification is only worth showing once it carries
  metadata and transport controls, which is #27's Android half. Stated here so the
  omission reads as a decision instead of an oversight.

  `stopWithTask="true"` because the audio this service exists to protect lives in
  the WebView, and the WebView dies with the task. Swiping the app away with the
  default `false` would leave a foreground service — and its notification — running
  with nothing playing and no page left to stop it. `ForayAudioPlugin.handleOnDestroy`
  covers the same hole from the other side; neither is redundant, because a task
  removal does not always deliver `onDestroy` to a plugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <service
            android:name="com.jwincorporated.foray.audio.PlaybackKeepAliveService"
            android:description="@string/foray_playback_service_description"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />
    </application>

</manifest>
