<?xml version="1.0" encoding="utf-8"?>
<!--
  The library manifest AGP merges into the generated app's manifest. Everything
  the foreground service needs to exist is declared HERE rather than patched into
  `mobile/android/app/src/main/AndroidManifest.xml` after generation, because that
  file is regenerated by `cap add android` and a patch step would have to be
  re-run. Manifest merging is what makes this survive a platform regeneration.

  FOREGROUND_SERVICE_MEDIA_PLAYBACK is required from Android 14 (API 34):
  "Beginning with Android 14 (API level 34), you must declare an appropriate
  service type for each foreground service" — and `mediaPlayback` is the type
  chosen because, unlike `dataSync` and `mediaProcessing`, it has no runtime
  prerequisites and NO RUNTIME TIMEOUT
  (docs/research/mp1-background-audio.md §5.3). A Foray is 45 to 90 minutes; a
  service type with a timeout would not survive one.

  POST_NOTIFICATIONS IS NOW DECLARED, AND #244 WAS RIGHT NOT TO. Its argument was
  that a foreground service runs whether or not its notification is shown, so the
  process-importance and audio-focus properties the service existed for did not
  depend on the permission — and that "the notification is only worth showing once
  it carries metadata and transport controls, which is #27's Android half."

  This is that half. The transport controls ARE the notification, and from Android
  13 (API 33) a notification the user has not permitted is not shown, so a denied
  permission is now the difference between a lock screen with controls and one
  without. The runtime request is `ForayAudioPlugin.requestNotifications`, asked
  once by the web half after the first accepted start — a `play()`, in the
  foreground, one press after the reason for it. Nothing here prompts on launch and
  a denial costs only the notification: the service still runs and the audio still
  plays.

  `stopWithTask="true"` because the audio this service exists to protect lives in
  the WebView, and the WebView dies with the task. Swiping the app away with the
  default `false` would leave a foreground service — and its notification — running
  with nothing playing and no page left to stop it. `ForayAudioPlugin.handleOnDestroy`
  covers the same hole from the other side; neither is redundant, because a task
  removal does not always deliver `onDestroy` to a plugin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A-25: the native engine's ExoPlayer deck (engine/ExoDeck.java) sets
         setWakeMode(C.WAKE_MODE_NETWORK), so the CPU and the Wi-Fi radio stay up while it
         plays with the screen off, and Media3 needs WAKE_LOCK to hold those locks. A normal
         (install-time) permission: no prompt and no Play declaration. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="ai.jwlabs.foura.audio.PlaybackKeepAliveService"
            android:description="@string/foray_playback_service_description"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!-- A-26 (docs/plans/android-assessment.md §5.4): the NATIVE engine's service, a Media3
             MediaSessionService. Native mode only (A-20 keeps Android on `js` until A-31), and
             then it replaces the service above, which stays exactly as it is for the JS lane.
             DECLARED SECOND ON PURPOSE: shell-invariants reads the FIRST <service> as the legacy
             one. Not exported: its clients are this app's own (a MediaController binds it by
             component, and Media3's notification and media-button PendingIntents run as this
             app). A-27's playback resumption did not open it: the receiver below is exported,
             and it starts this service as the same app. A-50's Android Auto is what would.
             The intent filter is the one Media3's SessionToken requires to bind. No
             stopWithTask: Media3's own onTaskRemoved stops it when nothing plays. -->
        <service
            android:name="ai.jwlabs.foura.audio.ForayPlaybackService"
            android:description="@string/foray_engine_service_description"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- A-27 (docs/plans/android-assessment.md §5.4): the media button receiver a car's PLAY
             reaches after the native engine's process died. Media3's MediaButtonReceiver starts
             the service above with the key event, and the session resumes from the engine's
             restore record (onPlaybackResumption). EXPORTED because the system delivers media
             button intents to it from outside the app. DISABLED IN THE MANIFEST ON PURPOSE:
             Media3 hands a manifest receiver to every session the app builds, the JS lane's
             included, and the JS lane has nothing to resume without its WebView.
             ForayPlaybackService.onCreate switches it on (native mode only), and the engine's
             store switches it off when nothing is left to resume. -->
        <receiver
            android:name="ai.jwlabs.foura.audio.ForayMediaButtonReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
