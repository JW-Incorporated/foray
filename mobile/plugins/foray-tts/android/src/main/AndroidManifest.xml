<?xml version="1.0" encoding="utf-8"?>
<!--
  The library manifest AGP merges into the generated app's manifest.

  NOTHING TO DECLARE beyond the empty application element below, and that
  is worth stating rather than leaving unexplained: android.speech.tts.TextToSpeech
  needs no uses-permission entry (it is not a dangerous permission, not a
  runtime-requested one, and not gated behind a foreground-service type the
  way foray-audio's mediaPlayback service is) and this plugin adds no
  service, receiver or activity of its own; TextToSpeech's engine binding is
  entirely internal to the framework class. An application element is what
  AGP's manifest merger expects as the library manifest's structure
  (mirroring foray-audio's own manifest shape, which also carries an
  application element even where it has nothing else to add). Note: an XML
  comment cannot contain two adjacent hyphen characters, which is why this
  comment is written without them (an earlier draft used a double hyphen and
  broke ManifestMerger2 with a parse error).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
    </application>

</manifest>
