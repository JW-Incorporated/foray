{
  "name": "foray-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Foray backend core: feed ingest, enrichment, curation engine, session builder.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "mutation": "stryker run",
    "build-session": "tsx src/cli/buildSession.ts",
    "build-ladder": "tsx src/cli/buildLadder.ts",
    "generate-foray": "tsx src/cli/generateForay.ts",
    "generate-forays": "tsx src/cli/generateForays.ts",
    "publish-foray": "tsx src/cli/publishForay.ts",
    "ingest-fixtures": "tsx src/cli/ingestFixtures.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "learn-interests": "tsx src/cli/learnInterests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.8"
  }
}
