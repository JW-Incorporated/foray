# retrieval.env.example -- the variable NAMES for /etc/foray/retrieval.env.
#
# GV-66 (docs/roadmap/generation-v2.md). Read by foray-retrieval.service and
# foray-index-nightly.service (EnvironmentFile=). Names only: this file holds
# no value, and deploy.test.mjs fails if one is added. The founder copies it to
# /etc/foray/retrieval.env (root:foray, mode 0640) and fills it in on the
# Spark (D8). Never commit a filled copy, and never paste one into a chat or
# an issue. Runbook: docs/plans/retrieval-on-spark.md.

# The bearer token, as the path of a file that holds it (suggested:
# /etc/foray/retrieval.token, root:foray, 0640). The server requires it on
# every /v1 route; nightly.mjs sends it to the loopback server. Prefer the file
# to FORAY_RETRIEVAL_TOKEN so the token is not in the process environment of
# every child.
FORAY_RETRIEVAL_TOKEN_FILE=

# The R2 READ key for foray-transcriptions, as the path of a credentials file
# (suggested: /etc/foray/r2-read.env, root:foray, 0640; format in
# tools/foraycorpus-export/README.md). Object Read only: nothing here writes R2.
R2_CREDENTIALS_FILE=

# Only when both units run with --embedder openai (an embedding model served
# on the second box or behind LiteLLM) instead of transformers. Leave unset
# otherwise. FORAY_EMBED_KEY is a secret: the founder places it.
FORAY_EMBED_URL=
FORAY_EMBED_MODEL=
FORAY_EMBED_DIM=
FORAY_EMBED_KEY=
