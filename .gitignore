node_modules/
.env
.env.*
!.env.example
*.log
.DS_Store
backend/output/

data/catalog-breadth-intl.json
*.checkpoint
data-local/

# Sweep checkpoint (tools/segments/sweep-transcripts.mjs). Machine state for
# resuming a killed run, not content — the committed artefact is
# data/transcript-availability.json.
data/transcript-progress.json
data/*.json.tmp

# Downloaded episode audio (tools/transcribe/fetch-audio.mjs, issue #120).
# A streaming pipeline, not an archive: files exist only between download and
# transcription and are deleted by cleanup(). Committing one would be tens of
# MB that no history rewrite gets back — fetch-audio.test.mjs asserts nothing
# under here is tracked.
audio-cache/
*.mp3
*.m4a
*.opus
*.flac
# ...except NE-25a's click tracks: synthesised test fixtures (a click every
# second, 964 KB for the whole set), not episode audio. Their exact bytes are
# pinned by tools/audio/click-tracks.test.mjs.
!mobile/plugins/foray-audio/ios/Tests/ForayAudioPluginTests/Fixtures/ClickTracks/*.mp3

# Vercel build output (tools/web/prepare-dist.mjs)
dist/
.vercel/

.vercel
.env*

# Generated by `xcodegen` from ios/project.yml (ci.yml's ios-kit job and any
# local `cd ios && xcodegen` run) — regenerated every time, never hand-edited.
ios/*.xcodeproj/
ios/App/Info.plist
__pycache__/

# Agent worktrees (`git worktree add .claude/worktrees/<name>`). Nested
# checkouts of this same repo, 81 of them at the time of writing: untracked and
# unignored, so `git add -A` in the main checkout tried to stage all of them.
# The worktrees themselves are managed by `git worktree`, never by `git add`.
.claude/worktrees/

# The deploy stamp (issue #701). Build outputs of tools/ci/generate-manifest.mjs,
# written into dist/ by tools/web/prepare-dist.mjs (Vercel) and into a throwaway
# checkout by .github/workflows/pages.yml — never into the working tree you
# commit from. They used to be committed, changed on every merge to main, and so
# conflicted with every open PR. `generate-manifest.mjs --check` (data-and-site)
# fails if either is tracked again. Root-anchored: only these exact paths.
/deploy-manifest.json
/data/forays-directory.json
