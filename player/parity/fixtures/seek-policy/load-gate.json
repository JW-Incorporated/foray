{
  "family": "seek-policy",
  "module": "player/seek-policy.js",
  "note": "ADR-0007's ladder AT LOAD (seek-policy.js segmentLoadGate, which PlayerQueueManager#_segmentGate asks and the native engine will too): a built Foray segment against the duration of the copy the listener was actually served, with and without ADR-0008's pad. The dai-synth-* cases are synthetic DAI copies: one 1800 s reference timeline with a 90 s pad, served with each ad load in the table, across the 30 s drift tolerance and the pad's own bound, with the pad off and on.",
  "cases": [
    {
      "id": "seek-policy/load-gate-settled-at-build",
      "covers": [],
      "note": "A segment buildForayQueue settled as exact (a static enclosure) never consults the gate again, whatever the copy reports.",
      "call": "segmentLoadGate",
      "args": [
        {
          "id": "f#1",
          "kind": "episode",
          "source_item_id": "ep-static",
          "dai_suspected": false,
          "needs_drift_check": false
        },
        { "observedDuration": 1800 }
      ],
      "expect": { "return": { "ok": true } }
    },
    {
      "id": "seek-policy/load-gate-no-item",
      "covers": [],
      "call": "segmentLoadGate",
      "args": [null, {}],
      "expect": { "return": { "ok": true } }
    },
    {
      "id": "seek-policy/load-gate-no-duration",
      "covers": [],
      "note": "The deck has not reported a duration: the ad load cannot be compared, so the segment is skipped rather than played at a guess.",
      "call": "segmentLoadGate",
      "args": [
        {
          "id": "f#3",
          "kind": "episode",
          "source_item_id": "ep-dai",
          "dai_suspected": true,
          "reference_duration_sec": 2501,
          "ad_pad_sec": null,
          "needs_drift_check": true
        },
        {}
      ],
      "expect": {
        "return": {
          "ok": false,
          "reason": "the copy in hand reports no duration, so the ad load cannot be compared to the reference"
        }
      }
    },
    {
      "id": "seek-policy/load-gate-nan-duration",
