          "foray": true,
          "stateType": "ended",
          "running": false,
          "hasCurrent": true,
          "queueLength": 1
        }
      ],
      "expect": { "return": "play-restored" }
    },
    {
      "id": "transport/toggle-restored-pause-is-a-pause",
