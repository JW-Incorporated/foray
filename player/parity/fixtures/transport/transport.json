{
  "family": "transport",
  "module": "player/transport-policy.js",
  "note": "The client layer's transport rules (player/transport-policy.js, NE-08), lifted out of client.js closures with no behaviour change. player/transport-policy.test.js reads these cases, so one file is both the JS assertion and the Swift case (TransportPolicy.swift, NE-09). Quirks of the old inline code are recorded as they are, not tidied.",
  "cases": [
    {
      "id": "transport/restart-window-4s",
      "covers": [
        "transport-policy::the restart window is 4 s, a Foray scrub lands 0.25 s inside the end, and an episode seek stops 1 s short"
      ],
      "authored": true,
      "note": "forayPrevious's convention: under 4 s into a clip, previous means the clip before. Authored: the number is the rule.",
      "read": "RESTART_WINDOW_SEC",
      "expect": { "value": 4 }
    },
    {
      "id": "transport/seek-inside-end-0.25s",
      "covers": [
        "transport-policy::the restart window is 4 s, a Foray scrub lands 0.25 s inside the end, and an episode seek stops 1 s short"
      ],
      "authored": true,
      "note": "A Foray-clock seek lands a quarter second inside the item, so the out-point stays armed (audit 2026-09-22). Authored.",
      "read": "SEEK_INSIDE_END_SEC",
      "expect": { "value": 0.25 }
    },
    {
      "id": "transport/seek-end-guard-1s",
      "covers": [
        "transport-policy::the restart window is 4 s, a Foray scrub lands 0.25 s inside the end, and an episode seek stops 1 s short"
      ],
      "authored": true,
      "note": "An episode seek stops 1 s short of the end, so a nudge never fires `ended`. Authored.",
      "read": "SEEK_END_GUARD_SEC",
      "expect": { "value": 1 }
    },
    {
      "id": "transport/toggle-restored",
      "covers": [
        "transport-policy::play on a restored bar starts the restored item, whatever else is true"
      ],
      "call": "resolveToggle",
      "args": [
        {
          "want": true,
          "restored": true,
          "foray": false,
          "stateType": "idle",
          "running": false,
          "hasCurrent": true,
          "queueLength": 0
        }
      ],
      "expect": { "return": "play-restored" }
    },
    {
      "id": "transport/toggle-restored-while-running",
      "covers": [
        "transport-policy::play on a restored bar starts the restored item, whatever else is true"
      ],
      "call": "resolveToggle",
