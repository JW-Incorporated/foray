        {
          "want": true,
          "restored": true,
          "foray": false,
          "stateType": "playing",
          "running": true,
          "hasCurrent": true,
          "queueLength": 1
        }
      ],
      "expect": { "return": "play-restored" }
    },
    {
      "id": "transport/toggle-restored-beats-finished-foray",
