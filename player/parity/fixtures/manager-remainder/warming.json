          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "window",
            "ops": ["load:s0@100", "rate:1", "outPoint:200", "play", "prefetch:line@0"],
            "playhead": "s0",
            "rate": 1,
            "state": "playing"
