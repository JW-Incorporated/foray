{
  "family": "manager-remainder",
  "note": "NE-39j: the queue-manager warming rules (§11, as NE-45j rewrote them), recorded from the real PlayerQueueManager over the shared FakeBackend with the web lane's prefetch contract opted in (setup.backend.prefetch, fakes.js). prefetch:<id>@<s> is the manager's ASK: which item the next boundary advances to, and at which in-point. Whether the deck then fetches, seeks or declines is the prepare families' n.prepare, asserted at the audible level. Port card NE-39s; JVM A-40 (owed whole).",
  "cases": [
    {
      "id": "manager-remainder/the-window-warms-the-next-segment-at-its-in-point",
      "covers": ["queue-manager::the window warms the next segment, at its own in-point"],
      "note": "The next segment's start_sec is the offset: not 0, and not a saved position.",
      "setup": { "target": "manager", "backend": { "prefetch": true } },
      "steps": [
        {
          "call": "loadQueue",
          "args": [
            [
              {
                "$seg": [
                  "s0",
                  100,
                  200,
                  { "audio_url": "https://cdn.example/a.mp3", "rate": 1 }
                ]
              },
              {
                "$seg": [
                  "s1",
                  300,
                  400,
                  { "audio_url": "https://cdn.example/b.mp3", "rate": 1 }
                ]
              },
              {
                "$seg": [
                  "s2",
                  500,
                  600,
                  { "audio_url": "https://cdn.example/c.mp3", "rate": 1 }
                ]
              }
            ]
          ]
        },
        { "call": "play", "args": [0] },
        { "deck": "window" },
        { "checkpoint": "window" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "window",
            "ops": ["load:s0@100", "rate:1", "outPoint:200", "play", "prefetch:s1@300"],
            "playhead": "s0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "end",
            "ops": [],
            "playhead": "s0",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": ["load:s0@100", "rate:1", "outPoint:200", "play", "prefetch:s1@300"]
      }
    },
    {
      "id": "manager-remainder/each-window-warms-what-its-boundary-advances-to",
      "covers": [
        "queue-manager::each boundary warms the item that boundary will actually advance to"
      ],
      "note": "After a Next, the next window warms the item after the NEW current one.",
      "setup": { "target": "manager", "backend": { "prefetch": true } },
      "steps": [
        {
          "call": "loadQueue",
          "args": [
            [
              {
                "$seg": [
                  "s0",
                  100,
                  200,
                  { "audio_url": "https://cdn.example/a.mp3", "rate": 1 }
                ]
              },
              {
                "$seg": [
                  "s1",
                  300,
                  400,
                  { "audio_url": "https://cdn.example/b.mp3", "rate": 1 }
                ]
              },
              {
                "$seg": [
                  "s2",
                  500,
                  600,
                  { "audio_url": "https://cdn.example/c.mp3", "rate": 1 }
                ]
              }
            ]
          ]
        },
        { "call": "play", "args": [0] },
        { "deck": "window" },
        { "checkpoint": "first" },
        { "call": "skipToNext" },
        { "deck": "window" },
        { "checkpoint": "second" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "first",
            "ops": ["load:s0@100", "rate:1", "outPoint:200", "play", "prefetch:s1@300"],
            "playhead": "s0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "second",
            "ops": [
              "pause",
              "load:s1@300",
              "rate:1",
              "outPoint:400",
              "play",
              "prefetch:s2@500"
            ],
            "playhead": "s1",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "end",
            "ops": [],
            "playhead": "s1",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": [
          "load:s0@100",
          "rate:1",
          "outPoint:200",
          "play",
          "prefetch:s1@300",
          "pause",
          "load:s1@300",
          "rate:1",
          "outPoint:400",
          "play",
          "prefetch:s2@500"
        ]
      }
    },
