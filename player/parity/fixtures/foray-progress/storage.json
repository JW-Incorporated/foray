          "rows": {
            "cp_foray:grilling-history-1": "{\"foray_id\":\"grilling-history-1\",\"title\":\"The history of grilling\",\"elapsed_sec\":1180,\"total_sec\":3673,\"index\":9,\"segment_id\":null,\"into_sec\":0,\"updated_at\":\"2026-08-16T10:00:00.000Z\"}",
