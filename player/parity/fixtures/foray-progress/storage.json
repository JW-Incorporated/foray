        "foray-progress::one Foray is one row, so two Forays cannot overwrite each other"
      ],
      "call": "storageRun",
      "args": [
        {
          "ops": [
            [
              "write",
              {
                "foray_id": "grilling-history-1",
                "title": "The history of grilling",
                "elapsed_sec": 1180,
                "total_sec": 3673,
                "index": 9,
                "segment_id": null,
                "into_sec": 0,
                "updated_at": "2026-08-16T10:00:00.000Z"
              }
            ],
            [
              "write",
              {
                "foray_id": "other-foray",
                "title": "The history of grilling",
                "elapsed_sec": 60,
                "total_sec": 3673,
                "index": 9,
                "segment_id": null,
                "into_sec": 0,
                "updated_at": "2026-08-16T10:00:00.000Z"
              }
            ],
            ["read", "grilling-history-1"],
            ["read", "other-foray"]
          ]
