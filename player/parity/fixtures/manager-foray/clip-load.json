{
  "family": "manager-foray",
  "note": "§16 of queue-manager.js (the M2 car drive, 2026-10-01): a Foray CLIP whose load fails, by deadline or by error, is loaded again ONCE at the same in-point, and a retry that fails too steps over the clip to the next item instead of leaving the Foray idle and silent. Paused during the load, the retry runs quietly and the listener's play finds the clip; a failed retry while paused stops as before. A plain episode is never retried. The deck keeping what the first attempt fetched (AVDeck continueInFlight) is the deck's, pinned by AVDeckTests.",
  "cases": [
    {
      "id": "manager-foray/a-clip-whose-load-fails-once-is-retried-and-plays",
      "covers": [
        "queue-manager::§16: a Foray clip whose load fails once is loaded again at the same in-point, and plays"
      ],
      "note": "The seam's load fails (the deck's deadline); the same clip at the same in-point is loaded again, lands, and plays. No pause, no idle, no step.",
      "setup": {
        "target": "manager",
        "catalogue": {
          "ep-static": {
            "id": "ep-static",
            "audio_url": "https://cdn.example/static.mp3",
            "dai_suspected": false,
            "duration_sec": 3600,
            "title": "Static",
            "show": "Indie"
          },
          "ep-other": {
            "id": "ep-other",
            "audio_url": "https://cdn.example/other.mp3",
            "dai_suspected": false,
            "duration_sec": 3600,
            "title": "Other",
            "show": "Indie"
          }
        },
        "backend": { "holdLoads": true }
      },
      "steps": [
        {
          "call": "playForay",
          "args": [
            {
              "id": "foray-1",
              "title": "Fire",
              "items": [
                {
                  "type": "segment",
                  "item_id": "ep-static",
                  "start_sec": 100,
                  "end_sec": 210,
                  "why": "he explains it plainly"
                },
                {
                  "type": "segment",
                  "item_id": "ep-other",
                  "start_sec": 400,
                  "end_sec": 500,
                  "why": "he explains it plainly"
                },
                {
                  "type": "segment",
                  "item_id": "ep-static",
                  "start_sec": 700,
                  "end_sec": 800,
                  "why": "he explains it plainly"
                }
              ]
            }
          ],
          "await": false
        },
        { "deck": "loaded", "id": "foray-1#0" },
        { "settle": 1 },
        { "checkpoint": "playing" },
        { "deck": "time", "sec": 210 },
        { "deck": "ended", "reason": "outPoint" },
        { "checkpoint": "seam" },
        { "deck": "loadFailed", "id": "foray-1#1" },
        { "checkpoint": "retrying" },
        { "deck": "loaded", "id": "foray-1#1" },
        { "settle": 1 },
        { "checkpoint": "retried" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "playing",
            "ops": ["load:foray-1#0@100", "rate:1", "outPoint:210", "play"],
            "playhead": "foray-1#0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": true,
            "index": 1,
            "name": "seam",
            "ops": ["load:foray-1#1@400"],
            "playhead": "foray-1#0",
            "rate": 1,
            "state": "loadingItem"
          },
          {
            "inInterlude": false,
            "inSeamGap": true,
            "index": 1,
            "name": "retrying",
            "ops": ["load:foray-1#1@400"],
            "playhead": "foray-1#0",
            "rate": 1,
            "state": "loadingItem"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "retried",
            "ops": ["rate:1", "outPoint:500", "play"],
            "playhead": "foray-1#1",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "end",
            "ops": [],
            "playhead": "foray-1#1",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": [
          "load:foray-1#0@100",
          "rate:1",
          "outPoint:210",
          "play",
          "load:foray-1#1@400",
          "load:foray-1#1@400",
