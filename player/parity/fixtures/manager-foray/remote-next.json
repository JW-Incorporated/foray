{
  "family": "manager-foray",
  "note": "NE-39n: the car's own Next over narration. Lock-screen and car presses (the runner's `remote` driver, through media-session.js mediaSessionActions over a real PlayerQueueManager, as media/remote.json does) on a literal Foray whose second item is a rendered narration line between two clips of one episode. In this family, not media, because a Foray with a narration line is the page's build (scenario-builds.json), which only the Foray-tape driver reads. Port: NE-39n (EngineCore.next).",
  "cases": [
    {
      "id": "manager-foray/remote-nexttrack-onto-a-line",
      "covers": [
        "media-session::nexttrack from a clip whose next item is a narration line lands on the line (NE-39n)"
      ],
      "note": "NE-39n: the car's Next from a clip whose next item is a narration line lands ON the line (the page's forayNext answer), never on the clip after it.",
      "setup": {
        "target": "manager",
        "seamGapSec": 0,
        "catalogue": {
          "ep-a": {
            "id": "ep-a",
            "title": "Fire",
            "show": "Origin Stories",
            "audio_url": "https://example.test/a.mp3",
            "duration_sec": 3600
          }
        }
      },
      "steps": [
        {
          "call": "setQueueFromForay",
          "args": [
            {
              "$foray": {
                "id": "foray-1",
                "title": "Fire",
                "items": [
                  {
                    "type": "segment",
                    "item_id": "ep-a",
                    "start_sec": 100,
                    "end_sec": 210
                  },
                  {
                    "type": "narration",
                    "id": "nar-1",
                    "asset": "narration/fire-1.mp3"
                  },
                  {
                    "type": "segment",
                    "item_id": "ep-a",
                    "start_sec": 400,
                    "end_sec": 520
                  }
                ]
              }
            }
          ]
        },
        { "call": "play", "args": [0] },
        { "checkpoint": "clip" },
        { "remote": "nexttrack" },
        { "checkpoint": "next" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "clip",
            "ops": ["load:foray-1#0@100", "rate:1", "outPoint:210", "play"],
            "playhead": "foray-1#0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "next",
            "ops": ["pause", "load:nar-1@0", "rate:1", "play"],
            "playhead": "nar-1",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "end",
            "ops": [],
            "playhead": "nar-1",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": [
          "load:foray-1#0@100",
          "rate:1",
          "outPoint:210",
          "play",
          "pause",
          "load:nar-1@0",
          "rate:1",
          "play"
        ]
      }
    },
    {
      "id": "manager-foray/remote-nexttrack-from-a-line",
      "covers": [
        "media-session::nexttrack from a narration line lands on the next clip at its in-point (NE-39n)"
      ],
      "note": "NE-39n: the car's Next from a narration line lands on the next clip, at its in-point with its out-point armed.",
      "setup": {
        "target": "manager",
        "seamGapSec": 0,
        "catalogue": {
          "ep-a": {
            "id": "ep-a",
            "title": "Fire",
            "show": "Origin Stories",
            "audio_url": "https://example.test/a.mp3",
            "duration_sec": 3600
          }
        }
      },
      "steps": [
        {
          "call": "setQueueFromForay",
          "args": [
            {
              "$foray": {
                "id": "foray-1",
                "title": "Fire",
                "items": [
                  {
                    "type": "segment",
                    "item_id": "ep-a",
                    "start_sec": 100,
                    "end_sec": 210
                  },
                  {
                    "type": "narration",
                    "id": "nar-1",
                    "asset": "narration/fire-1.mp3"
                  },
                  {
                    "type": "segment",
                    "item_id": "ep-a",
                    "start_sec": 400,
                    "end_sec": 520
                  }
                ]
              }
            }
          ]
        },
        { "call": "play", "args": [1] },
        { "checkpoint": "line" },
        { "remote": "nexttrack" },
        { "checkpoint": "next" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 1,
            "name": "line",
            "ops": ["load:nar-1@0", "rate:1", "play"],
            "playhead": "nar-1",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 2,
            "name": "next",
            "ops": [
              "store.save:nar-1@0",
              "pause",
              "load:foray-1#2@400",
              "rate:1",
              "outPoint:520",
              "play"
            ],
            "playhead": "foray-1#2",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 2,
            "name": "end",
            "ops": [],
            "playhead": "foray-1#2",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": [
          "load:nar-1@0",
          "rate:1",
          "play",
          "store.save:nar-1@0",
          "pause",
          "load:foray-1#2@400",
          "rate:1",
          "outPoint:520",
          "play"
        ]
      }
    }
  ]
}
