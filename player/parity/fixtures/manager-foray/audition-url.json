{
  "family": "manager-foray",
  "note": "NE-47 (Spark §3.3), against reference-engine: an audition that names a rendered preview.m4a plays it on the engine's preview deck under the tap's own activation, falls back to speaking the line when the file will not load, is refused engine-busy while running, and is cut by the next play. An audition with no url is audition.json's, unchanged. Port card NE-47.",
  "cases": [
    {
      "id": "manager-foray/audition-url-plays-the-rendered-preview",
      "covers": [],
      "authored": true,
      "note": "AUTHORED (NE-47): idle, an audition with a url loads the preview and plays it (no speech); a Foray started while it sounds cuts it before the first load; while the Foray runs the same audition is refused engine-busy and touches neither deck.",
      "setup": { "target": "engine" },
      "steps": [
        {
          "call": "audition",
          "source": "audition",
          "args": {
            "text": "This is how I sound",
            "voiceId": "voice-a",
            "url": "https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a"
          }
        },
        { "checkpoint": "previewing" },
        {
          "call": "playForay",
          "args": {
            "forayId": "f1",
            "title": "A Foray",
            "items": [
              {
                "type": "segment",
                "id": "s0",
                "audio_url": "https://cdn.test/a.mp3",
                "start_sec": 100,
                "end_sec": 200,
                "duration_sec": 3600
              },
              {
                "type": "segment",
                "id": "s1",
                "audio_url": "https://cdn.test/b.mp3",
                "start_sec": 300,
                "end_sec": 400,
                "duration_sec": 3600
              }
            ],
            "buildReport": {},
            "isLocalFile": false,
            "allowAdPad": false,
            "voiceId": null
          }
        },
        { "checkpoint": "running" },
        {
          "call": "audition",
          "source": "audition",
          "args": {
            "text": "This is how I sound",
            "voiceId": "voice-a",
            "url": "https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a"
          },
          "refused": "engine-busy"
        },
        { "checkpoint": "refused" }
      ],
      "expect": {
        "checkpoints": [
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": -1,
            "name": "previewing",
            "nowMs": 0,
            "ops": [
              "preview.load:https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a",
              "preview.play"
            ],
            "playhead": null,
            "rate": 1,
            "state": "idle"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "running",
            "nowMs": 0,
            "ops": ["preview.stop", "load:f1#0@100", "rate:1", "outPoint:200", "play"],
            "playhead": "f1#0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "refused",
            "nowMs": 0,
            "ops": [],
            "playhead": "f1#0",
            "rate": 1,
            "state": "playing"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "end",
            "nowMs": 0,
            "ops": [],
            "playhead": "f1#0",
            "rate": 1,
            "state": "playing"
          }
        ],
        "ops": [
          "preview.load:https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a",
          "preview.play",
          "preview.stop",
          "load:f1#0@100",
          "rate:1",
          "outPoint:200",
          "play"
        ]
      }
    },
    {
      "id": "manager-foray/audition-url-that-fails-is-spoken",
      "covers": [],
      "authored": true,
      "note": "AUTHORED (NE-47): a preview that will not load (a 404, a dead host, its deadline) is spoken instead, in the voice the page resolved, and the audition still answers ok. Paused mid-Foray, a preview plays and the paused item on the main deck is not touched.",
      "setup": {
        "target": "engine",
        "preview": {
          "failUrls": ["https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/am_echo/preview.m4a"]
