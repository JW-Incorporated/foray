            ],
            "playhead": null,
            "rate": 1,
            "state": "idle"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "paused",
            "nowMs": 0,
            "ops": ["load:f1#0@100", "rate:1", "outPoint:200", "play", "pause"],
            "playhead": "f1#0",
            "rate": 1,
            "state": "interrupted"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "previewing-while-paused",
            "nowMs": 0,
            "ops": [
              "preview.load:https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a",
              "preview.play"
            ],
            "playhead": "f1#0",
            "rate": 1,
            "state": "interrupted"
          },
          {
            "inInterlude": false,
            "inSeamGap": false,
            "index": 0,
            "name": "end",
            "nowMs": 0,
            "ops": [],
            "playhead": "f1#0",
            "rate": 1,
            "state": "interrupted"
          }
        ],
        "ops": [
          "preview.load:https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/am_echo/preview.m4a",
          "tts.speak:This is how I sound@1:voice-a",
          "load:f1#0@100",
          "rate:1",
          "outPoint:200",
          "play",
          "pause",
          "preview.load:https://audio.jwlabs.ai/n/kokoro-fp32-aac64-v1/af_heart/preview.m4a",
          "preview.play"
        ]
      }
    }
  ]
