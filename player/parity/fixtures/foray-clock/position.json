              "duration_sec": 3,
              "duration_source": "measured"
            },
            { "$seg": ["b", 400, 460, { "source_item_id": "ep-b" }] }
          ],
          "entries": [
            { "playable": true, "queueIndex": 0, "segment_id": "s1" },
            { "playable": true, "queueIndex": 1, "segment_id": null },
            { "playable": true, "queueIndex": 3, "segment_id": "s2" },
            { "playable": false, "queueIndex": null, "segment_id": "s9" }
          ]
        }
      ],
      "expect": {
        "return": [
          { "durationSec": 110, "id": "s1", "startSec": 0 },
          { "durationSec": 8, "id": null, "startSec": 110 },
          { "durationSec": 3, "id": null, "startSec": 118 },
          { "durationSec": 60, "id": "s2", "startSec": 121 }
        ]
