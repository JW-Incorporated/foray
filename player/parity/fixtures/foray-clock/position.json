      "id": "foray-clock/progress-segments",
      "covers": [],
      "note": "One row per playable item with its authored segment id (null for narration and the jingle, never invented) and its Foray-clock start and length: what resumePoint reconciles a stored row against.",
      "call": "progressSegments",
      "args": [
        {
          "playable": [
            { "$seg": ["a", 100, 210, { "source_item_id": "ep-a" }] },
            { "$tts": ["n1", { "duration_sec": 8, "duration_source": "measured" }] },
            {
              "id": "j1",
