{
  "family": "foray-clock",
  "module": "player/foray-resolve.js",
  "note": "Position across the whole Foray (player/foray-resolve.js): segmentStarts, segmentAtElapsed (clamped at both ends), forayElapsed (a segment's playhead minus its in-point; a narration item's playhead as is) and progressSegments, the running order resumePoint reconciles against. One queue of a segment, a narration bridge, a jingle and a segment, so each kind's clock is pinned. The page's display formatters (fmtClock, fmtSpan) are not the engine's. Port: NE-29s ForayClock.",
  "cases": [
    {
      "id": "foray-clock/starts-mixed",
      "covers": [],
      "call": "segmentStarts",
      "args": [
        [
          { "$seg": ["a", 100, 210, { "source_item_id": "ep-a" }] },
          { "$tts": ["n1", { "duration_sec": 8, "duration_source": "measured" }] },
          {
            "id": "j1",
            "kind": "jingle",
            "audio_url": "https://jw-incorporated.github.io/foray/player/assets/interlude-placeholder.wav",
            "duration_sec": 3,
            "duration_source": "measured"
          },
          { "$seg": ["b", 400, 460, { "source_item_id": "ep-b" }] }
        ]
      ],
      "expect": { "return": [0, 110, 118, 121] }
    },
    {
      "id": "foray-clock/starts-null",
      "covers": [],
      "call": "segmentStarts",
      "args": [null],
      "expect": { "return": [] }
    },
    {
      "id": "foray-clock/at-elapsed-zero",
      "covers": [],
      "call": "segmentAtElapsed",
      "args": [
