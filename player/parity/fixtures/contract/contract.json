      "id": "contract/commands",
      "covers": [],
      "read": "COMMANDS",
      "expect": {
        "value": [
          "playEpisode",
          "playForay",
          "setContinuation",
          "play",
          "pause",
          "toggle",
          "next",
          "previous",
          "seekBy",
          "seekTo",
          "jump",
          "stop",
          "setRate",
          "setVoice",
          "setInterludeEnabled",
          "setPageVisible",
          "ackAdvances",
          "ackEvents",
          "restoreBar",
          "purge",
          "relinquish",
          "audition",
          "setModeOverride",
          "setHoldPolicy",
          "probeSession"
