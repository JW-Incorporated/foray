              "mode": "none",
              "state": "idle",
              "running": false,
              "inSeamGap": false,
              "inInterlude": false,
              "buffering": false,
              "ended": false,
              "positionSec": 0,
              "durationSec": null,
              "sourceTimeSec": null,
              "playheadItemId": null,
              "isNarrationPlayhead": false,
              "rate": 1,
              "effectiveRate": 0,
              "canNext": false,
              "canPrevious": false,
              "autoAdvance": true,
              "skippedSegments": 0,
              "pendingAdvances": 0,
              "pendingEvents": 0,
              "session": "inactive",
              "holdPolicy": "forever",
              "nowPlaying": { "title": "", "artist": "", "album": "" }
            },
            "pendingAdvances": [{ "planSeq": 3, "hopSeq": 1, "nextId": "ep-2", "at": 1790000000000 }],
            "pendingEvents": [
              {
                "seq": 7,
                "kind": "position",
                "episode_id": "ep-1",
                "seconds": 60,
                "duration": 3600,
                "at": 1790000000000
              }
            ]
          }
        }
      ],
      "expect": { "return": { "mode": "js", "reason": "protocol-mismatch", "relinquish": true } }
    },
    {
      "id": "handshake/decide-native",
