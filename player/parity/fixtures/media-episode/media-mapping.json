      "args": [{ "$undefined": true }],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-number",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
      "call": "artworkUrl",
      "args": [7],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-object",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
      "call": "artworkUrl",
      "args": [{}],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-array",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
      "call": "artworkUrl",
      "args": [[]],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-apple-size-and-type",
      "covers": [
        "media-session::mediaArtwork reads the size off the URL Apple already encodes it in"
      ],
      "call": "mediaArtwork",
      "args": [
        "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg"
      ],
      "expect": {
        "return": {
          "sizes": "600x600",
          "src": "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg",
          "type": "image/jpeg"
        }
      }
    },
    {
      "id": "media-episode/artwork-type-png",
      "covers": [
        "media-session::mediaArtwork infers the MIME type from the extension, and omits it when unknown"
      ],
      "call": "mediaArtwork",
      "args": ["https://x/y.png"],
      "expect": { "return": { "src": "https://x/y.png", "type": "image/png" } }
    },
    {
      "id": "media-episode/artwork-type-webp",
      "covers": [
        "media-session::mediaArtwork infers the MIME type from the extension, and omits it when unknown"
      ],
      "call": "mediaArtwork",
      "args": ["https://x/y.webp"],
      "expect": { "return": { "src": "https://x/y.webp", "type": "image/webp" } }
    },
    {
      "id": "media-episode/artwork-no-extension-no-type-no-size",
      "covers": [
        "media-session::mediaArtwork infers the MIME type from the extension, and omits it when unknown"
      ],
      "call": "mediaArtwork",
      "args": ["https://x/y"],
      "expect": { "return": { "src": "https://x/y" } }
    },
    {
      "id": "media-episode/artwork-caller-override",
      "covers": ["media-session::mediaArtwork lets the caller override size and type"],
      "call": "mediaArtwork",
      "args": ["icon-512.png", { "sizes": "512x512", "type": "image/png" }],
      "expect": { "return": { "sizes": "512x512", "src": "icon-512.png", "type": "image/png" } }
    },
    {
      "id": "media-episode/artwork-refused-url-is-null",
      "covers": [
        "media-session::mediaArtwork returns null for a refused URL rather than an entry with no src"
      ],
      "call": "mediaArtwork",
      "args": ["javascript:alert(1)"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-null-url-is-null",
      "covers": [
        "media-session::mediaArtwork returns null for a refused URL rather than an entry with no src"
      ],
      "call": "mediaArtwork",
      "args": [null],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-list-prefers-show",
      "covers": [
        "media-session::mediaArtworkList prefers the publisher's square when we have one",
        "media-session::mediaArtworkList never offers both — the OS picks by size, not by preference"
      ],
      "call": "mediaArtworkList",
      "args": [
        {
          "showArtworkUrl": "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg"
        }
      ],
      "expect": {
        "return": [
          {
            "sizes": "600x600",
            "src": "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg",
            "type": "image/jpeg"
          }
        ]
      }
    },
    {
      "id": "media-episode/artwork-list-falls-back-to-app-icon",
      "covers": [
        "media-session::mediaArtworkList falls back to the app icon, so the lock screen is never blank"
      ],
      "call": "mediaArtworkList",
      "args": [{ "showArtworkUrl": null }],
      "expect": { "return": [{ "sizes": "512x512", "src": "icon-512.png", "type": "image/png" }] }
    },
    {
      "id": "media-episode/artwork-list-empty-options-one-entry",
      "covers": [
        "media-session::mediaArtworkList never offers both — the OS picks by size, not by preference"
      ],
      "call": "mediaArtworkList",
      "args": [{}],
      "expect": { "return": [{ "sizes": "512x512", "src": "icon-512.png", "type": "image/png" }] }
    },
    {
      "id": "media-episode/artwork-list-empty-when-nothing-usable",
      "covers": [
        "media-session::mediaArtworkList is empty when neither the show's square nor the app icon is usable"
      ],
      "call": "mediaArtworkList",
      "args": [{ "showArtworkUrl": "javascript:x", "appArtworkUrl": "http://x/y.png" }],
      "expect": { "return": [] }
    },
    {
      "id": "media-episode/artwork-list-refused-show-degrades-to-icon",
      "covers": [
        "media-session::a refused show artwork URL degrades to the app icon rather than to nothing"
      ],
      "call": "mediaArtworkList",
      "args": [{ "showArtworkUrl": "javascript:alert(1)" }],
      "expect": { "return": [{ "sizes": "512x512", "src": "icon-512.png", "type": "image/png" }] }
    },
    {
      "id": "media-episode/read-app-artwork-url",
      "covers": [
        "media-session::mediaArtworkList falls back to the app icon, so the lock screen is never blank"
      ],
      "read": "APP_ARTWORK_URL",
      "expect": { "value": "icon-512.png" }
    },
    {
      "id": "media-episode/segment-title-episode-artist-show",
      "covers": ["media-session::a segment puts the episode in title and the SHOW in artist"],
      "call": "mediaMetadata",
      "args": [
        {
          "item": {
            "kind": "episode",
            "title": "Episode 09: Did Cooking Make Us Human?",
            "show": "Origin Stories",
            "start_sec": 10,
            "end_sec": 120
          },
          "forayTitle": "The history of grilling",
          "index": 0,
          "total": 32
        }
      ],
      "expect": {
        "return": {
          "album": "The history of grilling · clip 1 of 32",
          "artist": "Origin Stories",
          "artwork": [{ "sizes": "512x512", "src": "icon-512.png", "type": "image/png" }],
          "title": "Episode 09: Did Cooking Make Us Human?"
        }
      }
    },
    {
      "id": "media-episode/album-foray-title-and-counter",
      "covers": [
