      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-space",
      "covers": ["media-session::artworkUrl refuses a URL carrying a control character"],
      "call": "artworkUrl",
      "args": ["java script:alert(1)"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-relative-icon",
