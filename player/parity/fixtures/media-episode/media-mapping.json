{
  "family": "media-episode",
  "module": "player/media-session.js",
  "note": "The lock-screen mapping (player/media-session.js) that NE-12s ports as MediaMapping: the artwork gate, mediaMetadata with albumOf, mediaPositionState, mediaPlaybackState and mediaSessionView, one case per assertion of media-session.test.js. A test whose assertions are pure calls into these functions is fixtured here even when its inputs are Foray-shaped (a title and a part counter, a seam beat): NE-12s ports each function whole, and a branch left out would ship untested for a milestone. Narration and jingle items, narrationCredit, the committed Forays and a Foray-loaded manager are NE-29j's (unported.json, family media); the navigator.mediaSession bridge and the client.js text scans are excluded (exclusions.json).",
  "cases": [
    {
      "id": "media-episode/artwork-url-https-apple",
      "covers": ["media-session::artworkUrl passes https through unchanged"],
      "call": "artworkUrl",
      "args": [
        "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg"
      ],
      "expect": {
        "return": "https://is1-ssl.mzstatic.com/image/thumb/Podcasts126/v4/ab/mza_124.jpg/600x600bb.jpg"
      }
    },
    {
      "id": "media-episode/artwork-url-https-query-fragment",
      "covers": ["media-session::artworkUrl passes https through unchanged"],
      "call": "artworkUrl",
      "args": ["https://example.com/a.png?x=1#y"],
      "expect": { "return": "https://example.com/a.png?x=1#y" }
    },
    {
      "id": "media-episode/artwork-url-data-image",
      "covers": ["media-session::artworkUrl passes a data:image URI"],
      "call": "artworkUrl",
      "args": ["data:image/png;base64,iVBORw0KGgo="],
      "expect": { "return": "data:image/png;base64,iVBORw0KGgo=" }
    },
    {
      "id": "media-episode/artwork-url-refuses-javascript",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["javascript:alert(1)"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-javascript-mixed-case",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["JavaScript:alert(1)"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-vbscript",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["vbscript:msgbox"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-data-text-html",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["data:text/html,<b>"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-blob",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["blob:https://x/y"],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-file",
      "covers": [
        "media-session::artworkUrl refuses every scheme that can execute or that the CSP blocks"
      ],
      "call": "artworkUrl",
      "args": ["file:///etc/passwd"],
      "expect": { "return": null }
    },
