      ],
      "call": "artworkUrl",
      "args": [""],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-blank",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
      "call": "artworkUrl",
      "args": ["   "],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-null",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
      "call": "artworkUrl",
      "args": [null],
      "expect": { "return": null }
    },
    {
      "id": "media-episode/artwork-url-refuses-undefined",
      "covers": [
        "media-session::artworkUrl refuses empty, blank and non-string input rather than passing it on"
      ],
