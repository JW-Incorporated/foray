        "media-session::a SEGMENT keeps Apple Podcasts parity untouched: title=episode, artist=show, album=foray+part"
      ],
      "call": "mediaMetadata",
      "args": [
        {
          "item": {
            "kind": "episode",
            "title": "Episode 09: Did Cooking Make Us Human?",
            "show": "Origin Stories",
            "start_sec": 10,
            "end_sec": 120
          },
          "forayTitle": "The history of grilling",
          "index": 11,
          "total": 32
        }
      ],
      "expect": {
        "return": {
          "album": "The history of grilling · clip 12 of 32",
          "artist": "Origin Stories",
          "artwork": [{ "sizes": "512x512", "src": "icon-512.png", "type": "image/png" }],
          "title": "Episode 09: Did Cooking Make Us Human?"
        }
      }
    },
