              "watchdog.arm:250",
              "watchdog.arm:250"
            ],
            "playing": true,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210.004,
            "fired": true,
            "name": "observer-stops",
            "nowMs": 109990,
            "ops": ["watchdog.cancel", "outPoint.stop:boundary:4"],
            "playing": false,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210.004,
            "fired": true,
            "name": "the-watchdog-is-gone",
            "nowMs": 110990,
            "ops": ["outPoint.stale:endTime"],
            "playing": false,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210.004,
            "fired": true,
            "name": "end",
            "nowMs": 110990,
            "ops": [],
            "playing": false,
            "rate": 1
          }
        ],
        "ops": [
          "endTime:210",
          "boundary:210",
          "watchdog.arm:108500",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.cancel",
          "outPoint.stop:boundary:4",
          "outPoint.stale:endTime"
        ]
      }
    },
