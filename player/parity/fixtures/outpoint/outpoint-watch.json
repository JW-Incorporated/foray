{
  "family": "outpoint",
  "note": "The native out-point on the op log (deck-policy.js outPointStep, driven by runner.js's deck target: a wall clock, a playhead that moves by elapsed x rate while playing and not stalled, and the watchdog's timer delivered when it comes due). Ops: endTime:/boundary: are layers 1 and 2 set or cleared, watchdog.arm:<ms>/watchdog.cancel the one timer, outPoint.stop:<layer>:<overshootMs> the stop, outPoint.early:/outPoint.stale: a report that stops nothing.",
  "cases": [
    {
      "id": "outpoint/driven-clock-watchdog-backstop",
      "covers": [],
      "note": "Layers 1 and 2 stay quiet: the watchdog alone stops the segment. One timer until the window, then 250 ms polls, and the stop lands on the boundary.",
      "setup": { "target": "deck" },
      "steps": [
        { "deck": "load", "outPointSec": 210, "sec": 100 },
        { "deck": "play" },
        { "checkpoint": "playing" },
        { "clock": 100000 },
        { "checkpoint": "outside-the-window" },
        { "clock": 10000 },
        { "checkpoint": "end-of-segment" }
      ],
      "expect": {
        "checkpoints": [
          {
            "armed": true,
            "atSec": 100,
            "fired": false,
            "name": "playing",
            "nowMs": 0,
            "ops": ["endTime:210", "boundary:210", "watchdog.arm:108500"],
            "playing": true,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 200,
            "fired": false,
            "name": "outside-the-window",
            "nowMs": 100000,
            "ops": [],
            "playing": true,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210,
            "fired": true,
            "name": "end-of-segment",
            "nowMs": 110000,
            "ops": [
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "outPoint.stop:watchdog:0"
            ],
            "playing": false,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210,
            "fired": true,
            "name": "end",
            "nowMs": 110000,
            "ops": [],
            "playing": false,
            "rate": 1
          }
        ],
        "ops": [
          "endTime:210",
          "boundary:210",
          "watchdog.arm:108500",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "outPoint.stop:watchdog:0"
        ]
      }
    },
    {
      "id": "outpoint/end-time-wins-first-layer-only",
      "covers": [],
      "authored": true,
      "note": "Never early in EVERY layer: an observer that reports a millisecond short stops nothing and re-arms the watchdog. The first layer to report AT the boundary wins; later reports for the same token are stale.",
      "setup": { "target": "deck" },
      "steps": [
        { "deck": "load", "outPointSec": 210, "sec": 100 },
        { "deck": "play" },
        { "clock": 109999 },
        { "checkpoint": "a-millisecond-short" },
        { "deck": "boundary" },
        { "checkpoint": "an-early-report" },
        { "clock": 1 },
        { "deck": "endTime" },
        { "checkpoint": "layer-one-stops" },
        { "deck": "boundary" },
        { "clock": 5000 },
        { "checkpoint": "the-rest-are-stale" }
      ],
      "expect": {
        "checkpoints": [
          {
            "armed": true,
            "atSec": 209.999,
            "fired": false,
            "name": "a-millisecond-short",
            "nowMs": 109999,
            "ops": [
              "endTime:210",
              "boundary:210",
              "watchdog.arm:108500",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250",
              "watchdog.arm:250"
            ],
            "playing": true,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 209.999,
            "fired": false,
            "name": "an-early-report",
            "nowMs": 109999,
            "ops": ["outPoint.early:boundary", "watchdog.cancel", "watchdog.arm:4"],
            "playing": true,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210,
            "fired": true,
            "name": "layer-one-stops",
            "nowMs": 110000,
            "ops": ["watchdog.cancel", "outPoint.stop:endTime:0"],
            "playing": false,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210,
            "fired": true,
            "name": "the-rest-are-stale",
            "nowMs": 115000,
            "ops": ["outPoint.stale:boundary"],
            "playing": false,
            "rate": 1
          },
          {
            "armed": true,
            "atSec": 210,
            "fired": true,
            "name": "end",
            "nowMs": 115000,
            "ops": [],
            "playing": false,
            "rate": 1
          }
        ],
        "ops": [
          "endTime:210",
          "boundary:210",
          "watchdog.arm:108500",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "watchdog.arm:250",
          "outPoint.early:boundary",
          "watchdog.cancel",
          "watchdog.arm:4",
          "watchdog.cancel",
          "outPoint.stop:endTime:0",
          "outPoint.stale:boundary"
        ]
      }
    },
    {
      "id": "outpoint/boundary-observer-wins",
      "covers": [],
      "note": "The boundary observer reports first, with the playhead it read 4 ms past the boundary: it wins, the overshoot is those 4 ms, and the watchdog's pending poll is cancelled rather than left to fire.",
      "setup": { "target": "deck" },
      "steps": [
        { "deck": "load", "outPointSec": 210, "sec": 100 },
        { "deck": "play" },
        { "clock": 109990 },
        { "checkpoint": "ten-milliseconds-short" },
        { "deck": "boundary", "sec": 210.004 },
        { "checkpoint": "observer-stops" },
        { "deck": "endTime" },
        { "clock": 1000 },
        { "checkpoint": "the-watchdog-is-gone" }
      ],
      "expect": {
        "checkpoints": [
