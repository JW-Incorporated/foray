{
  "family": "prepare-narration",
  "module": "player/deck-policy.js",
  "note": "NE-45j's pure half: warmsAcross (the next item is prepared when it has a file, whatever the beat) and prefetchWindowOpens with durationSec (an item with no out-point opens its window the lead before its duration ends; one shorter than the lead opens at its start). Port card NE-45s (DeckPolicy.swift); JVM A-62.",
  "cases": [
    {
      "id": "prepare-narration/warms-clip-to-clip",
      "covers": [],
      "call": "warmsAcross",
      "args": [
        {
          "from": {
            "id": "s0",
            "kind": "episode",
            "audio_url": "https://cdn.test/a.mp3",
            "start_sec": 100,
            "end_sec": 200
          },
          "to": {
            "id": "s1",
            "kind": "episode",
            "audio_url": "https://cdn.test/b.mp3",
            "start_sec": 300,
            "end_sec": 400
          }
        }
      ],
      "expect": { "return": true }
    },
    {
      "id": "prepare-narration/warms-clip-to-rendered-line",
      "covers": [],
      "note": "A seam with a line in it gets no beat (seam-gap.js), and is prepared anyway: the rule is the file, not the beat.",
      "call": "warmsAcross",
      "args": [
        {
          "from": {
            "id": "s0",
            "kind": "episode",
            "audio_url": "https://cdn.test/a.mp3",
            "start_sec": 100,
            "end_sec": 200
          },
          "to": {
            "id": "n1",
            "kind": "tts",
            "audio_url": "https://cdn.test/n1.m4a",
            "script": "A line."
          }
        }
      ],
      "expect": { "return": true }
    },
    {
      "id": "prepare-narration/warms-rendered-line-to-clip",
      "covers": [],
      "call": "warmsAcross",
      "args": [
        {
          "from": {
            "id": "n1",
            "kind": "tts",
            "audio_url": "https://cdn.test/n1.m4a",
            "script": "A line."
          },
          "to": {
            "id": "s1",
            "kind": "episode",
            "audio_url": "https://cdn.test/b.mp3",
            "start_sec": 300,
            "end_sec": 400
          }
        }
      ],
      "expect": { "return": true }
    },
    {
      "id": "prepare-narration/warms-spoken-line-to-clip",
      "covers": [],
      "note": "Whether is the file; WHEN (at the spoken line's start) is the manager's.",
      "call": "warmsAcross",
      "args": [
        {
          "from": { "id": "n1", "kind": "tts", "audio_url": null, "script": "A line." },
          "to": {
            "id": "s1",
            "kind": "episode",
            "audio_url": "https://cdn.test/b.mp3",
            "start_sec": 300,
            "end_sec": 400
          }
        }
      ],
      "expect": { "return": true }
    },
    {
      "id": "prepare-narration/warms-natural-end-to-clip",
      "covers": [],
      "call": "warmsAcross",
      "args": [
        {
          "from": { "id": "e1", "kind": "episode", "audio_url": "https://cdn.test/e.mp3" },
          "to": {
            "id": "s1",
            "kind": "episode",
            "audio_url": "https://cdn.test/b.mp3",
            "start_sec": 300,
            "end_sec": 400
          }
        }
      ],
      "expect": { "return": true }
    },
    {
      "id": "prepare-narration/spoken-line-is-not-warmed",
      "covers": [],
      "note": "No file: the synthesiser speaks it.",
      "call": "warmsAcross",
      "args": [
        {
          "from": {
            "id": "s0",
            "kind": "episode",
            "audio_url": "https://cdn.test/a.mp3",
