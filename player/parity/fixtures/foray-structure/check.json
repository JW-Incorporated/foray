{
  "family": "foray-structure",
  "module": "player/foray-structure.js",
  "note": "J-4 (plan §5.2 playForay: 'the engine re-validates structure'): player/foray-structure.js structuralCheck, buildForayQueue's post-condition stated once — ids present and unique, a known kind, audio for a segment and a jingle, finite forward bounds, ADR-0007's anchors for a DAI source, a reference duration for a segment the ladder checks at load, narration that can be heard, and a positive duration for everything the clock cannot subtract — answered as refused-structure with every problem named. And seamCensus, what each join is by the manager's own seam rules. Port: NE-29s StructuralCheck.",
  "cases": [
    {
      "id": "foray-structure/refused-structure",
      "covers": [],
      "read": "REFUSED_STRUCTURE",
      "expect": { "value": "refused-structure" }
    },
    {
      "id": "foray-structure/queue-kinds",
      "covers": [],
      "read": "QUEUE_KINDS",
      "expect": { "value": ["episode", "tts", "jingle"] }
    },
    {
      "id": "foray-structure/structure-problems",
      "covers": [],
      "read": "STRUCTURE_PROBLEMS",
      "expect": {
        "value": [
          "empty",
          "not-an-object",
          "no-id",
          "duplicate-id",
          "unknown-kind",
          "no-audio",
          "bad-bounds",
          "dai-unanchored",
          "no-reference",
          "silent-narration",
          "no-duration"
        ]
      }
    },
    {
      "id": "foray-structure/check-valid-mixed",
      "covers": [],
      "note": "Segments, a script-only narration line and a jingle: what buildForayQueue emits.",
      "call": "structuralCheck",
      "args": [
        [
          {
            "$seg": [
              "f#0",
              100,
              210,
              { "audio_url": "https://example.test/a.mp3", "source_item_id": "ep-a" }
            ]
          },
          {
            "$tts": [
              "bridge-1",
              {
                "script": "Next, the other side.",
                "duration_sec": 1.235,
                "duration_source": "estimated",
                "audio_url": null
              }
            ]
          },
          {
            "id": "jingle-1",
            "kind": "jingle",
            "audio_url": "https://jw-incorporated.github.io/foray/player/assets/interlude-placeholder.wav",
            "duration_sec": 3,
            "duration_source": "measured"
          },
          {
            "$seg": [
              "f#3",
              400,
              460,
              { "audio_url": "https://example.test/b.mp3", "source_item_id": "ep-b" }
            ]
          },
          {
            "$seg": [
              "f#4",
              900,
              1000,
              { "audio_url": "https://example.test/b.mp3", "source_item_id": "ep-b" }
            ]
          }
        ]
      ],
      "expect": { "return": { "ok": true, "problems": [], "reason": null } }
    },
    {
      "id": "foray-structure/check-empty",
      "covers": [],
      "call": "structuralCheck",
      "args": [[]],
      "expect": {
        "return": {
          "ok": false,
          "problems": [{ "code": "empty", "index": -1 }],
          "reason": "refused-structure"
        }
