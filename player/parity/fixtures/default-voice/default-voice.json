{
  "family": "default-voice",
  "module": "player/default-voice.js",
  "note": "pickDefaultVoice — the Samantha ruling of 2026-09-10 (authored) — and the helpers it is built from (bestInstalledByName, qualityRank, primarySubtag, isEnglish), one case per assertion of default-voice.test.js. That suite is not one of the plan's fifteen covered suites, so each case names its test in the note rather than in covers. The voice choice is the page's decision (plan §3 A-1); the engine ports the rule so a native cold start with no cp_voice speaks in the same voice the page would pick. Port: NE-33.",
  "cases": [
    {
      "id": "default-voice/name-is-samantha",
      "covers": [],
      "authored": true,
      "note": "Founder ruling 2026-09-10: Samantha is the default voice. Authored. default-voice.test.js: 'the default is Samantha, requested across every English locale'.",
      "read": "DEFAULT_VOICE_NAME",
      "expect": { "value": "Samantha" }
    },
    {
      "id": "default-voice/list-lang-en",
      "covers": [],
      "authored": true,
      "note": "A bare primary subtag is what makes both native halves widen to every en-* voice. Authored. default-voice.test.js: 'the default is Samantha, requested across every English locale'.",
      "read": "VOICE_LIST_LANG",
      "expect": { "value": "en" }
    },
    {
      "id": "default-voice/stock-phone",
      "covers": [],
      "note": "default-voice.test.js: 'on a stock phone the default is Samantha compact, not whichever novelty voice sorts first'. Albert sorts first at the same tier and must not win.",
      "call": "pickDefaultVoice",
      "args": [
        [
          {
            "identifier": "com.apple.speech.synthesis.voice.Albert",
            "name": "Albert",
            "language": "en-US",
            "quality": "default"
          },
          {
            "identifier": "com.apple.eloquence.en-US.Eddy",
            "name": "Eddy",
            "language": "en-US",
            "quality": "default"
          },
          {
            "identifier": "com.apple.ttsbundle.Samantha-compact",
            "name": "Samantha",
            "language": "en-US",
            "quality": "default"
          },
          {
            "identifier": "com.apple.speech.synthesis.voice.Zarvox",
            "name": "Zarvox",
            "language": "en-US",
            "quality": "default"
          },
          {
            "identifier": "com.apple.ttsbundle.Daniel-compact",
            "name": "Daniel",
            "language": "en-GB",
            "quality": "default"
          }
        ]
      ],
      "expect": { "return": "com.apple.ttsbundle.Samantha-compact" }
    },
