    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "snapshot",
            "advanced",
            "skipped",
            "error",
            "voiceFallback",
            "diag",
            "modeChanged"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "snapshot" } }, "required": ["type"] },
          "then": {
            "required": ["snapshot"],
            "properties": { "snapshot": { "$ref": "#/$defs/snapshot" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "error" } }, "required": ["type"] },
          "then": {
            "required": ["code"],
            "properties": { "code": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "modeChanged" } }, "required": ["type"] },
          "then": {
            "required": ["mode", "reason"],
            "properties": {
              "mode": { "enum": ["native", "legacy"] },
              "reason": {
                "enum": [
                  "build-default",
                  "override",
                  "no-plist-key",
                  "not-built",
                  "crash-loop",
                  "page-health",
                  "downgrade"
                ]
              }
            }
          }
        }
      ],
      "x-examples": {
        "valid": {
          "snapshot": {
            "type": "snapshot",
            "snapshot": {
              "v": 1,
              "seq": 42,
              "capturedAtWallMs": 1790000000000,
              "capturedAtMonotonicMs": 523000,
