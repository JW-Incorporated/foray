{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-incorporated.github.io/foray/player/parity/schema/engine-contract.schema.json",
  "title": "Foray web <-> native engine contract, protocol v1 (docs/native-engine-plan.md §5)",
  "description": "GENERATED from player/engine-contract.js by `node tools/parity/contract-schema.mjs --write` - do not edit. Every payload that crosses the engineHello / engineSend / engineRead bridge and the 'engine' event. Each public $def carries x-examples {valid, invalid}; each example is one case of the contract (or snapshot) parity family, so the page's validator and Swift's decoding give the same accept/reject answers. Unknown keys are allowed everywhere: an additive field is not a protocol change.",
  "x-kinds": [
    "helloRequest",
    "helloResponse",
    "sendRequest",
    "sendResponse",
    "readRequest",
    "rowsResponse",
    "diagnosticsResponse",
    "snapshot",
    "event"
  ],
  "$defs": {
    "helloRequest": {
      "type": "object",
      "required": ["pageBuild", "protocol"],
      "properties": {
        "pageBuild": { "type": "string" },
        "protocol": { "type": "integer", "minimum": 1 }
      },
      "x-examples": {
        "valid": { "page-v1": { "pageBuild": "2026.09.24-1", "protocol": 1 } },
        "invalid": {
          "missing-protocol": { "pageBuild": "2026.09.24-1" },
          "protocol-string": { "pageBuild": "2026.09.24-1", "protocol": "1" }
        }
      }
    },
    "helloResponse": {
      "type": "object",
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["native", "legacy"] },
        "reason": {
          "enum": [
            "build-default",
            "override",
            "no-plist-key",
            "not-built",
            "crash-loop",
            "page-health",
            "downgrade"
          ]
        },
        "engineVersion": { "type": "string" },
        "protocol": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "array",
          "items": { "enum": ["episode", "continuation", "restore", "foray"] }
        },
        "ownedKeyPrefixes": { "type": "array", "items": { "type": "string" } },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "pendingAdvances": { "type": "array", "items": { "$ref": "#/$defs/hop" } },
        "pendingEvents": { "type": "array", "items": { "$ref": "#/$defs/pendingEvent" } }
      },
      "if": { "properties": { "mode": { "const": "native" } }, "required": ["mode"] },
      "then": {
        "required": ["engineVersion", "protocol", "capabilities", "ownedKeyPrefixes", "snapshot"]
      },
      "x-examples": {
        "valid": {
          "not-built-stub": { "mode": "legacy", "reason": "not-built" },
          "native": {
            "mode": "native",
            "reason": "build-default",
            "engineVersion": "1.0.0",
            "protocol": 1,
            "capabilities": ["episode", "restore"],
            "ownedKeyPrefixes": ["cp_pos:", "cp_foray:", "cp_last_episode"],
            "snapshot": {
              "v": 1,
              "seq": 0,
              "capturedAtWallMs": 1790000000000,
              "capturedAtMonotonicMs": 0,
              "mode": "none",
              "state": "idle",
              "running": false,
              "inSeamGap": false,
              "inInterlude": false,
              "buffering": false,
              "ended": false,
              "positionSec": 0,
              "durationSec": null,
              "sourceTimeSec": null,
              "playheadItemId": null,
              "isNarrationPlayhead": false,
              "rate": 1,
              "effectiveRate": 0,
              "canNext": false,
              "canPrevious": false,
              "autoAdvance": true,
              "skippedSegments": 0,
              "pendingAdvances": 0,
              "pendingEvents": 0,
              "session": "inactive",
              "holdPolicy": "forever",
              "nowPlaying": { "title": "", "artist": "", "album": "" }
            },
            "pendingAdvances": [{ "planSeq": 3, "hopSeq": 1, "nextId": "ep-2", "at": 1790000000000 }],
            "pendingEvents": [
              {
                "seq": 7,
                "kind": "position",
                "episode_id": "ep-1",
                "seconds": 60,
                "duration": 3600,
                "at": 1790000000000
              }
            ]
          },
          "crash-loop-legacy": { "mode": "legacy", "reason": "crash-loop", "protocol": 1 }
        },
        "invalid": {
          "mode-js": { "mode": "js", "reason": "build-default" },
          "reason-free-text": { "mode": "legacy", "reason": "the engine felt unwell" },
          "native-without-snapshot": {
            "mode": "native",
            "reason": "override",
            "engineVersion": "1.0.0",
            "protocol": 1,
            "capabilities": ["episode"],
            "ownedKeyPrefixes": ["cp_pos:", "cp_foray:", "cp_last_episode"]
          },
          "unknown-capability": {
            "mode": "native",
            "reason": "override",
            "engineVersion": "1.0.0",
            "protocol": 1,
            "capabilities": ["carplay"],
            "ownedKeyPrefixes": ["cp_pos:", "cp_foray:", "cp_last_episode"],
            "snapshot": {
              "v": 1,
              "seq": 0,
              "capturedAtWallMs": 1790000000000,
              "capturedAtMonotonicMs": 0,
              "mode": "none",
              "state": "idle",
              "running": false,
              "inSeamGap": false,
              "inInterlude": false,
              "buffering": false,
              "ended": false,
              "positionSec": 0,
              "durationSec": null,
              "sourceTimeSec": null,
              "playheadItemId": null,
              "isNarrationPlayhead": false,
              "rate": 1,
              "effectiveRate": 0,
              "canNext": false,
              "canPrevious": false,
              "autoAdvance": true,
              "skippedSegments": 0,
              "pendingAdvances": 0,
              "pendingEvents": 0,
              "session": "inactive",
              "holdPolicy": "forever",
              "nowPlaying": { "title": "", "artist": "", "album": "" }
            }
          }
        }
      }
    },
    "sendRequest": {
      "type": "object",
      "required": ["v", "cmdSeq", "cmd", "source"],
      "properties": {
        "v": { "const": 1 },
        "cmdSeq": { "type": "integer", "minimum": 0 },
        "cmd": {
          "enum": [
            "playEpisode",
            "playForay",
            "setContinuation",
            "play",
            "pause",
            "toggle",
            "next",
            "previous",
            "seekBy",
            "seekTo",
            "jump",
            "stop",
            "setRate",
            "setVoice",
            "setInterludeEnabled",
            "setPageVisible",
            "ackAdvances",
            "ackEvents",
            "restoreBar",
            "purge",
            "relinquish",
            "audition",
            "setModeOverride",
            "setHoldPolicy",
            "probeSession",
            "simulateTermination"
          ]
        },
        "args": { "type": "object" },
        "source": {
          "enum": [
            "tap",
            "remote",
            "reconcile",
            "session",
            "restore",
            "autoadvance",
            "autoresume",
            "audition"
          ]
        },
        "issuedAtWallMs": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "cmd": { "const": "playEpisode" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["item", "lastEpisodeRow"],
                "properties": {
                  "item": { "$ref": "#/$defs/item" },
                  "startSec": { "type": "number", "minimum": 0 },
                  "moved": { "type": "boolean" },
                  "lastEpisodeRow": {
                    "type": "object",
                    "required": ["id"],
                    "properties": { "id": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "playForay" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "forayId",
                  "title",
                  "items",
                  "buildReport",
                  "isLocalFile",
                  "allowAdPad",
                  "voiceId"
                ],
                "properties": {
                  "forayId": { "type": "string", "minLength": 1 },
                  "title": { "type": "string" },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/item" }
                  },
                  "buildReport": { "type": "object" },
                  "startElapsedSec": { "type": "number", "minimum": 0 },
                  "isLocalFile": { "type": "boolean" },
                  "allowAdPad": { "type": "boolean" },
                  "voiceId": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "cmd": { "const": "setContinuation" } },
            "required": ["cmd"]
          },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["planSeq", "autoAdvance", "chain"],
                "properties": {
                  "planSeq": { "type": "integer", "minimum": 0 },
                  "autoAdvance": { "type": "boolean" },
                  "chain": { "type": "array", "items": { "$ref": "#/$defs/hop" } },
                  "previous": { "anyOf": [{ "$ref": "#/$defs/hop" }, { "type": "null" }] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "seekBy" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["deltaSec"],
                "properties": { "deltaSec": { "type": "number" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "seekTo" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["sec"],
                "properties": { "sec": { "type": "number", "minimum": 0 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "jump" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["index"],
                "properties": { "index": { "type": "integer", "minimum": 0 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "stop" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["persist"],
                "properties": { "persist": { "type": "boolean" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "setRate" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["rate"],
                "properties": { "rate": { "type": "number", "exclusiveMinimum": 0 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "setVoice" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["voiceId"],
                "properties": { "voiceId": { "type": ["string", "null"] } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "cmd": { "const": "setInterludeEnabled" } },
            "required": ["cmd"]
          },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["enabled"],
                "properties": { "enabled": { "type": "boolean" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "cmd": { "const": "setPageVisible" } },
            "required": ["cmd"]
          },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["visible"],
                "properties": { "visible": { "type": "boolean" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "ackAdvances" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["upToSeq"],
                "properties": { "upToSeq": { "type": "integer", "minimum": 0 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "ackEvents" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["upToSeq"],
                "properties": { "upToSeq": { "type": "integer", "minimum": 0 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "relinquish" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["cap"],
                "properties": {
                  "cap": { "enum": ["episode", "continuation", "restore", "foray", "all"] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "audition" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["text", "voiceId"],
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "voiceId": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "cmd": { "const": "setModeOverride" } },
            "required": ["cmd"]
          },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "enum": ["auto", "native", "web"] } }
              }
            }
          }
        },
        {
          "if": { "properties": { "cmd": { "const": "setHoldPolicy" } }, "required": ["cmd"] },
          "then": {
            "required": ["args"],
            "properties": {
              "args": {
                "type": "object",
                "required": ["policy"],
                "properties": {
                  "policy": {
                    "type": "string",
                    "pattern": "^(forever|none|until:[1-9][0-9]{0,5})$"
                  }
                }
              }
            }
          }
        }
      ],
      "x-examples": {
        "valid": {
          "play-tap": {
            "v": 1,
            "cmdSeq": 5,
            "cmd": "play",
            "source": "tap",
            "issuedAtWallMs": 1790000000000
          },
          "play-episode": {
            "v": 1,
            "cmdSeq": 6,
            "cmd": "playEpisode",
            "source": "tap",
            "args": {
              "item": {
                "id": "ep-1",
                "kind": "episode",
                "audio_url": "https://example.com/a.mp3"
              },
              "startSec": 30,
              "lastEpisodeRow": { "id": "ep-1", "title": "An Episode" }
            }
          },
          "relinquish-foray": {
            "v": 1,
            "cmdSeq": 7,
            "cmd": "relinquish",
            "source": "tap",
            "args": { "cap": "foray" }
          },
          "set-hold-until": {
            "v": 1,
            "cmdSeq": 8,
            "cmd": "setHoldPolicy",
            "source": "tap",
            "args": { "policy": "until:60" }
          },
          "set-continuation": {
            "v": 1,
            "cmdSeq": 9,
            "cmd": "setContinuation",
            "source": "restore",
            "args": {
              "planSeq": 3,
              "autoAdvance": false,
              "chain": [{ "planSeq": 3, "hopSeq": 1, "nextId": "ep-2" }]
            }
          },
          "stop-data-deletion": {
            "v": 1,
            "cmdSeq": 10,
            "cmd": "stop",
            "source": "tap",
            "args": { "persist": false }
          }
        },
        "invalid": {
          "unknown-cmd": { "v": 1, "cmdSeq": 5, "cmd": "fastForward", "source": "tap" },
          "wrong-version": { "v": 2, "cmdSeq": 5, "cmd": "play", "source": "tap" },
          "unknown-source": { "v": 1, "cmdSeq": 5, "cmd": "play", "source": "siri" },
          "relinquish-without-cap": { "v": 1, "cmdSeq": 5, "cmd": "relinquish", "source": "tap", "args": {} },
          "relinquish-unknown-cap": {
            "v": 1,
            "cmdSeq": 5,
            "cmd": "relinquish",
            "source": "tap",
            "args": { "cap": "everything" }
          },
          "hold-until-zero": {
            "v": 1,
            "cmdSeq": 5,
            "cmd": "setHoldPolicy",
            "source": "tap",
            "args": { "policy": "until:0" }
          },
          "play-episode-without-row": {
            "v": 1,
            "cmdSeq": 5,
            "cmd": "playEpisode",
            "source": "tap",
            "args": { "item": { "id": "ep-1" } }
          },
          "negative-seq": { "v": 1, "cmdSeq": -1, "cmd": "play", "source": "tap" },
          "override-unknown-mode": {
            "v": 1,
            "cmdSeq": 5,
            "cmd": "setModeOverride",
            "source": "tap",
            "args": { "mode": "legacy" }
          }
        }
      }
    },
    "sendResponse": {
      "type": "object",
      "required": ["ok", "snapshot"],
      "properties": {
        "ok": { "type": "boolean" },
        "reason": {
          "enum": [
            "not-loaded",
            "no-next",
            "no-previous",
            "ended",
            "refused-structure",
            "capability-off",
            "session-failed:cannot-interrupt-others",
            "session-failed:cannot-start-playing",
            "session-failed:other",
            "engine-busy",
            "relinquished",
            "unknown-cmd"
          ]
        },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      },
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "required": ["reason"] },
