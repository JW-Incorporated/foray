{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/web/prepare-dist.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install --prefix api",
  "framework": null,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(app.js|search-engine.js|styles.css|sw.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/player/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
