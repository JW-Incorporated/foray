{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/web/prepare-dist.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci --prefix api --prefer-offline --no-audit --no-fund && npm ci --omit=dev --prefix backend --prefer-offline --no-audit --no-fund",
  "ignoreCommand": "node tools/web/vercel-should-build.mjs",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/{catalog.json,catalog-breadth.json,shows-index-pointer.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/data/(forays|segments|segment-sources)\\.json",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(app.js|search-engine.js|styles.css|sw.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/player/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
