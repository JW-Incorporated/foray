{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/web/prepare-dist.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install --prefix api && npm install --omit=dev --prefix backend",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/{catalog.json,catalog-breadth.json,shows-index-pointer.json}"
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/data/(forays|segments|segment-sources)\\.json",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(app.js|search-engine.js|styles.css|sw.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/player/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
